rules_version = '2';

/**
 * Правила доступа к Firestore.
 *
 * Вся бизнес-логика живёт на бэкенде, который ходит в базу через Admin SDK —
 * правила на него не распространяются. Клиенты же (мобильное приложение
 * и панель) обращаются к данным только через этот бэкенд.
 *
 * Поэтому правила запрещают клиентам всё. Это не перестраховка: ключ
 * приложения Firebase публичен и лежит в любом собранном клиенте. Открой
 * коллекции на чтение — и любой сотрудник прочитает чужие оклады напрямую,
 * минуя проверки прав, а заодно и подделает себе отметку прихода.
 *
 * Если когда-нибудь понадобится прямое чтение с клиента, правила добавляются
 * точечно и только на те коллекции, где это безопасно, — а не «всем ACTIVE».
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Запрет по умолчанию распространяется на все коллекции, включая те,
    // которые появятся позже: новая коллекция закрыта, пока не решено иначе.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
