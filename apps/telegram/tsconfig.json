{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@corpsol/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ]
}
