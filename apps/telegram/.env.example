# Мини-апп для Telegram. Скопируйте в .env.local и заполните.
#
# Vite подставляет VITE_* в сборку, поэтому это не секреты: ключ
# Firebase для браузера публичен по своей природе. Секретный токен
# бота живёт только на сервере — TELEGRAM_BOT_TOKEN в apps/api.

VITE_API_URL=http://localhost:3001/api

# Те же значения, что NEXT_PUBLIC_FIREBASE_* у панели.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=corpsol-local
VITE_FIREBASE_APP_ID=

# Для локальной разработки на эмуляторах.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
