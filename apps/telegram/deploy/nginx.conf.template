server {
  listen ${PORT};
  root /usr/share/nginx/html;

  # Файлы сборки с хешем в имени не меняются — кешируем надолго.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Страницу не кешируем: иначе Telegram показывал бы старую версию
  # после выкладки, пока кеш WebView не протухнет.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
