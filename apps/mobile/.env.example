# Адрес бэкенда. Для разработки на устройстве укажи IP машины в локальной сети —
# localhost внутри приложения указывает на сам телефон.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3001/api

# Firebase. Значения публичные по своей природе: доступ ограничивают
# правила безопасности и проверки на бэкенде, а не секретность этих ключей.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Локальная разработка через эмулятор Firebase Auth.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=192.168.0.10:9099
