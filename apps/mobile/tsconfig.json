{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    // База Expo задаёт устаревшее "node", которое новые версии TypeScript
    // считают ошибкой. Перекрываем на "bundler": это и актуальное имя,
    // и режим, соответствующий тому, как Metro собирает приложение —
    // с учётом поля "exports" в package.json.
    "moduleResolution": "bundler",
    // Без baseUrl: опция удалена в TypeScript 7. Пути в paths теперь
    // задаются относительно самого конфига и требуют ведущего "./".
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
