# Проект Firebase и сервисный аккаунт с правами Admin SDK.
# Ключ скачивается в консоли Firebase: Project settings → Service accounts.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Приватный ключ одной строкой, переводы строк экранированы как \n
FIREBASE_PRIVATE_KEY=""

# Локальная разработка через эмуляторы Firebase.
# Если переменные заданы, Admin SDK подключается к ним вместо облака.
# FIRESTORE_EMULATOR_HOST="localhost:8080"
# FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"

PORT=3001
