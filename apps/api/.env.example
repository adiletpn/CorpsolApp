# Бэкенд CorpSol. Скопируйте в .env и заполните.
#
# Локальная разработка идёт на эмуляторах — тогда нужны только
# FIRESTORE_EMULATOR_HOST, FIREBASE_AUTH_EMULATOR_HOST и FIREBASE_PROJECT_ID,
# а сервисный ключ не требуется: эмуляторы не проверяют подпись.

# ---- общее ----

PORT=3001

# ---- локальная разработка на эмуляторах ----

FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=corpsol-local

# ---- облачный проект ----
#
# Задаются вместо двух строк выше. Ключ берётся из консоли Firebase:
# Project settings → Service accounts → Generate new private key.
#
# Переводы строк в ключе экранируются: вся строка должна остаться одной.
# Без этого Admin SDK молча не проходит подпись.

# FIREBASE_PROJECT_ID=corpsol-prod
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@corpsol-prod.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---- мини-апп в Telegram ----
#
# Токен бота из @BotFather. По нему сервер проверяет подпись строки
# запуска мини-аппа: без него номер аккаунта Telegram можно подделать
# и войти за коллегу. Не задан — мини-апп не пускает менеджеров.

# TELEGRAM_BOT_TOKEN=123456789:AA...

# ---- сид ----
#
# Сид создаёт учётки с общеизвестным паролем, поэтому против боевого
# проекта он заблокирован. Снимать защиту только осознанно.

# ALLOW_PRODUCTION_SEED=yes
