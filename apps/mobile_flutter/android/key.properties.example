# Подпись релизной сборки. Скопируйте в android/key.properties
# и заполните. Сам файл и хранилище ключа в репозиторий не попадают.
#
# Хранилище создаётся один раз:
#
#   keytool -genkey -v -keystore ~/corpsol-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Потеряете ключ — обновление приложения выпустить будет нельзя.
# Храните копию там же, где остальные ключи от магазинов.

storeFile=/Users/you/corpsol-upload.jks
storePassword=
keyAlias=upload
keyPassword=
