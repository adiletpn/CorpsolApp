{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // moduleResolution намеренно не задан: прежние имена "node" и "node10"
    // удалены в TypeScript 7, а подходящего явного значения для commonjs
    // там нет. Без опции компилятор сам выбирает режим по "module",
    // и это тот же самый разбор путей, что был раньше.
    "module": "commonjs",
    "declaration": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
